# --- Event copy (optional) ---
NEXT_PUBLIC_EVENT_NAME="Anniversary Photo Wall"
NEXT_PUBLIC_WORDMARK="EasyStepIn"
NEXT_PUBLIC_COMMUNITY_NAME="EasyStepIn"

# --- Supabase (leave unset to run in local DEMO mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser

# --- Admin ---
ADMIN_USERNAME=admin              # /admin login name (default: admin)
ADMIN_PASSWORD=                   # required for /admin
SESSION_SECRET=                   # openssl rand -hex 32

# --- Optional image content-safety (Google Cloud Vision SafeSearch) ---
GOOGLE_VISION_API_KEY=
